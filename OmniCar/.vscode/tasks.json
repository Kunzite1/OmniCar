{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "cmake --build build",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "flash",
            "type": "shell",
            "command": "openocd -f interface/stlink.cfg -f target/stm32f4x.cfg -c \"program build/OmniCar.elf verify reset exit\"",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "dependsOn": ["build"],
            "problemMatcher": []
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "cmake --build build --target clean",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": []
        }
    ]
}
