# ============= EIDE / VS Code / IDE 配置 =============
# 用户特定的 IDE 配置，不应进入版本库
/.vscode/launch.json
/.vscode/tasks.json
/.vscode/settings.json
/.vscode/*.code-workspace
/.settings
/.eide/log
/.eide.usr.ctx.json
/.eide/cache
/.cmsis/device
/.cmsis/include

# ============= 项目输出 =============
# EIDE 模板与构建输出
/build
/bin
/obj
/out

# EIDE 临时/模板文件
*.ept
*.eide-template

# ============= Keil MDK 工程文件 =============
# Keil 用户界面布局（按用户保存，包含屏幕布局等）
Template.uvgui.*
Template.uvguix.*
# Keil 调试/构建选项（按用户保存）
Template.uvopt
Template.uvoptx
# Keil 上一次保存的工程文件
Template.uvproj.saved_uv4
# J-Link 调试器设置（含序列号等硬件信息，按机器保存）
JLinkSettings.ini
# Keil RTE 自动生成的运行时环境组件
/RTE/

# ============= 构建产物 =============
# 目标文件 / 依赖文件
*.o
*.d
*.axf
*.bin
*.hex
*.elf
*.map
*.lst
*.crf
*.htm
*.dep
*.lnp
*.iex
# 浏览信息 / 预编译头
*.browse
*.build_log.htm
*.htm.*
*.tmp
# 链接脚本生成文件（与 IDE 强绑定）
*.sct

# ============= 日志与临时文件 =============
*.log
*.bak
*.swp
*.swo
*~